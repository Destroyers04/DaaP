DISCORD_TOKEN=your-test-bot-token
DISCORD_GUILD_ID=your-test-server-id

# Verification
DATABASE_PATH=data/daap.db
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# NEVER change or lose this. Every stored email hash depends on it.
EMAIL_HASH_SECRET=

# Email (Brevo): Settings -> SMTP & API -> API Keys
# Set to "dev" to log codes instead of sending real emails.
BREVO_API_KEY=
# Must be a verified sender in Brevo (Senders, Domains & Dedicated IPs -> Senders)
MAIL_FROM_ADDRESS=daap.discord.bot@gmail.com
MAIL_FROM_NAME=DaaP Verification

# Backups: webhook for a private channel (Channel Settings -> Integrations -> Webhooks)
BACKUP_WEBHOOK_URL=
